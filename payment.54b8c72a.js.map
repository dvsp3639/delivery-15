/* ---------------- STATUS API ---------------- */ async function checkPaymentStatus(merchantOrderId, accessToken) {
    try {
        const response = await fetch(`https://api.phonepe.com/apis/identity-manager/checkout/v2/order/${merchantOrderId}/status`, {
            method: "GET",
            headers: {
                "Content-Type": "application/json",
                Authorization: `O-Bearer ${accessToken}`
            }
        });
        return await response.json();
    } catch (err) {
        console.error("Status Check Error:", err);
        return {
            state: "FAILED"
        };
    }
}

