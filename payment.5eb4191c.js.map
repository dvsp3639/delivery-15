/* ============================================================
   ✅ PAYMENT.JS (Frontend)
   Works with GitHub Pages + Google Apps Script Backend
   NO direct PhonePe API calls (avoids CORS)
   ============================================================ */ const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzUoipr4E1vEpEJ32ZP0aLAtAoCt2WNqXpJR6V57rxBerR8zA-F2PF_II8OqEe2_OVFjg/exec";
/* ---------------- GET CUSTOMER INFO FROM URL ---------------- */ const params = new URLSearchParams(window.location.search);
const mobile_cust = params.get("mobile");
const name_cust = params.get("name");
console.log("Customer Mobile:", mobile_cust);
console.log("Customer Name:", name_cust);
/* ---------------- START PAYMENT ---------------- */ async function initiatePhonePePayment(totalAmount) {
    try {
        console.log("\u2705 Starting Payment:", totalAmount);
        // Call backend Apps Script
        const formData = new URLSearchParams();
        formData.append("action", "createPayment");
        formData.append("amount", totalAmount);
        const res = await fetch(SCRIPT_URL, {
            method: "POST",
            body: formData
        });
        const data = await res.json();
        console.log("Backend Payment Response:", data);
        if (!data.success || !data.redirectUrl) {
            alert("\u274C Payment link not received!");
            return;
        }
        // Save Order ID locally for status check later
        localStorage.setItem("merchantOrderId", data.merchantOrderId);
        // ✅ Redirect user to PhonePe hosted checkout
        window.location.href = data.redirectUrl;
    } catch (err) {
        console.error("Payment Start Error:", err);
        alert("\u274C Unable to start payment.");
    }
}
/* ---------------- CHECK STATUS AFTER REDIRECT ---------------- */ async function verifyPaymentAfterRedirect() {
    const merchantOrderId = localStorage.getItem("merchantOrderId");
    if (!merchantOrderId) return;
    console.log("\uD83D\uDD0D Checking Payment Status:", merchantOrderId);
    const formData = new URLSearchParams();
    formData.append("action", "checkStatus");
    formData.append("merchantOrderId", merchantOrderId);
    const res = await fetch(SCRIPT_URL, {
        method: "POST",
        body: formData
    });
    const data = await res.json();
    console.log("Status Response:", data);
    if (!data.success) {
        alert("\u274C Payment Status Failed");
        return;
    }
    const state = data.status?.data?.state;
    if (state === "COMPLETED") {
        console.log("\u2705 Payment Completed!");
        // Send WhatsApp confirmation
        sendWhatsappMessage();
        // Redirect success page
        window.location.href = "/success.html";
    } else if (state === "FAILED") window.location.href = "/failure.html";
    else alert("\u26A0\uFE0F Payment Pending...");
}
/* ---------------- SEND WHATSAPP ---------------- */ async function sendWhatsappMessage() {
    try {
        console.log("\uD83D\uDCE9 Sending WhatsApp...");
        const formData = new URLSearchParams();
        formData.append("action", "sendWhatsapp");
        formData.append("mobile", mobile_cust);
        formData.append("name", name_cust);
        const res = await fetch(SCRIPT_URL, {
            method: "POST",
            body: formData
        });
        const data = await res.json();
        console.log("WhatsApp Response:", data);
    } catch (err) {
        console.error("WhatsApp Error:", err);
    }
}
/* ---------------- AUTO VERIFY ON PAGE LOAD ---------------- */ window.onload = function() {
    verifyPaymentAfterRedirect();
};

